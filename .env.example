# ===== คัดลอกไฟล์นี้เป็นชื่อ .env แล้วกรอกค่าจริงของคุณ =====

# จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=วางค่าจาก_LINE_Developers_ตรงนี้
LINE_CHANNEL_SECRET=วางค่าจาก_LINE_Developers_ตรงนี้

# จาก Google AI Studio (aistudio.google.com) > Get API Key (ฟรี)
GEMINI_API_KEY=วางค่าจาก_Google_AI_Studio_ตรงนี้

# User ID ของ "ตัวคุณเอง" ใน LINE (ไว้รับแจ้งเตือนเมื่อมีลูกค้าสนใจจ้างงาน)
# วิธีหา: ดูในคู่มือ "หาค่า OWNER_LINE_USER_ID" ขั้นตอนที่ 6
OWNER_LINE_USER_ID=วางค่า_LINE_User_ID_ของคุณ_ตรงนี้

# ชื่อ/ธุรกิจของคุณ ให้บอทแนะนำตัวถูกต้อง
BUSINESS_NAME=ชื่อร้าน หรือ ชื่อช่างภาพของคุณ
WEBSITE_URL=https://your-portfolio-site.netlify.app

# พอร์ตที่ server จะรัน (Render จะกำหนดให้อัตโนมัติ ไม่ต้องแก้)
PORT=3000
